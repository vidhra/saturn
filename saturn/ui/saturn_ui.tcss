/* Saturn TUI Stylesheet - Modern terminal UI styling */

/* Global app styling */
App {
    background: $background 90%;
}

/* Header styling */
Header {
    background: $primary;
    color: $text;
    text-style: bold;
}

/* Main container layout */
#main-container {
    layout: vertical;
    height: 100%;
}

/* Status panel at top */
#status-panel {
    height: 4;
    background: $surface;
    border: solid $primary;
    padding: 1;
}

#state-display {
    layout: vertical;
    height: 100%;
}

#state-label {
    text-style: bold;
    color: $accent;
}

#progress-label {
    color: $text-muted;
    text-style: italic;
}

#step-label {
    color: $text-muted;
}

/* Chat area styling */
#chat-area {
    height: 1fr;
    background: $background;
    border: solid $surface;
    padding: 1;
    scrollbar-background: $surface;
    scrollbar-color: $primary;
}

/* Execution overlay for real-time feedback */
#execution-overlay {
    height: 3;
    background: $surface-darken-1;
    border: solid $warning;
    padding: 1;
    dock: bottom;
}

#execution-status {
    color: $text-muted;
    text-style: italic;
    text-align: center;
}

#execution-progress {
    width: 100%;
    color: $accent;
}

/* Input area styling */
#input-area {
    height: 4;
    background: $surface;
    border: solid $primary;
    padding: 1;
    layout: horizontal;
}

#command-input {
    width: 1fr;
    background: $background;
    border: solid $accent;
    color: $text;
}

#command-input:focus {
    border: solid $success;
}

#send-button {
    width: 10;
    margin-left: 1;
    background: $accent;
    color: $text;
}

#send-button:hover {
    background: $accent-lighten-1;
}

/* Message styling */
.user-message {
    background: $primary-darken-2;
    border-left: solid $primary;
    padding: 1;
    margin: 1 0;
    color: $text;
}

.assistant-message {
    background: $success-darken-3;
    border-left: solid $success;
    padding: 1;
    margin: 1 0;
    color: $text;
}

.system-message {
    background: $surface-darken-1;
    border-left: solid $warning;
    padding: 1;
    margin: 1 0;
    color: $text-muted;
    text-style: italic;
}

/* Execution trace panel */
ExecutionTrace {
    height: 1fr;
    background: $surface-darken-2;
    border: solid $text-muted;
    padding: 1;
    display: none;
}

ExecutionTrace.visible {
    display: block;
}

/* Footer styling */
Footer {
    background: $surface;
    color: $text-muted;
}

/* Markdown content styling */
Markdown {
    background: transparent;
    color: $text;
    padding: 0 1;
}

Markdown H1 {
    color: $accent;
    text-style: bold;
}

Markdown H2 {
    color: $primary;
    text-style: bold;
}

Markdown H3 {
    color: $success;
    text-style: bold;
}

Markdown Code {
    background: $surface-darken-1;
    color: $accent;
    text-style: bold;
}

Markdown BlockQuote {
    background: $surface-darken-1;
    border-left: solid $accent;
    padding: 0 1;
    margin: 1 0;
}

Markdown List {
    margin: 1 0;
}

/* Progress bar styling */
ProgressBar {
    background: $surface;
    color: $success;
    height: 1;
}

ProgressBar > .bar {
    background: $success;
}

/* Button styling */
Button {
    text-style: bold;
    margin: 0 1;
    min-width: 8;
}

Button.primary {
    background: $accent;
    color: $text;
}

Button.primary:hover {
    background: $accent-lighten-1;
}

Button.primary:focus {
    background: $accent-lighten-2;
}

/* Label styling */
Label {
    color: $text;
    text-align: left;
}

/* Static widget styling */
Static {
    color: $text;
}

/* Scrollbar styling */
VerticalScroll > .scrollbar {
    background: $surface;
    color: $primary;
    width: 1;
}

VerticalScroll:focus > .scrollbar {
    background: $surface-lighten-1;
}

/* Container styling */
Container {
    background: transparent;
}

/* Color scheme variables */
/* Dark theme optimized for terminal usage */
$background: #0a0a0a;
$surface: #1a1a1a;
$surface-darken-1: #141414;
$surface-darken-2: #0f0f0f;
$surface-lighten-1: #252525;

$primary: #00b4d8;
$primary-darken-2: #0077b6;
$accent: #90e0ef;
$accent-lighten-1: #caf0f8;
$accent-lighten-2: #e8f7fa;

$success: #06ffa5;
$success-darken-3: #004d40;
$warning: #ffb700;
$error: #ff006e;

$text: #ffffff;
$text-muted: #888888;

/* Responsive design */
@media (max-width: 80) {
    #input-area {
        layout: vertical;
        height: 6;
    }
    
    #send-button {
        width: 100%;
        margin-left: 0;
        margin-top: 1;
    }
}

/* Animation effects */
#execution-status {
    text-opacity: 0.8;
}

#execution-progress {
    text-opacity: 0.9;
}

/* Focus styling */
*:focus {
    border: solid $accent;
}

/* Hover effects */
Button:hover {
    text-style: bold;
    text-opacity: 1.0;
}

/* Loading states */
.loading {
    text-style: italic;
    color: $text-muted;
    text-opacity: 0.7;
}

/* Error states */
.error {
    color: $error;
    text-style: bold;
}

/* Success states */
.success {
    color: $success;
    text-style: bold;
} 