{
  "servers": {
          "filesystem": {
        "name": "filesystem",
        "transport": "stdio",
        "command": "npx",
        "args": ["-y", "@modelcontextprotocol/server-filesystem", "/tmp"],
        "description": "File system operations",
        "enabled": false
      },
    "fetch": {
      "name": "fetch",
      "transport": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-fetch"],
      "description": "Web content fetching",
      "enabled": false
    },
    "github": {
      "name": "github",
      "transport": "stdio",
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-e",
        "GITHUB_PERSONAL_ACCESS_TOKEN",
        "ghcr.io/github/github-mcp-server"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "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"
      },
        "enabled": true,
        "description": "GitHub operations (Docker-based)"
    }
  }
}
